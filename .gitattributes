# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Paths excluded from Composer / Packagist dist archives (git archive).
# `docs/` is shipped so README links and deep-dive guides resolve under vendor/.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/art                export-ignore
/tests              export-ignore
/workbench          export-ignore
/.editorconfig      export-ignore
/.php_cs.dist.php   export-ignore
/psalm.xml          export-ignore
/psalm.xml.dist     export-ignore
/testbench.yaml     export-ignore
/UPGRADING.md       export-ignore
/phpstan.neon.dist  export-ignore
/rector.php         export-ignore
/pint.json          export-ignore
/yarn.lock          export-ignore
/scripts            export-ignore
/laravel-ai-agent-kit-threat-model.md  export-ignore
/security_best_practices_report.md     export-ignore

# Redirect-stub docs kept in the repo to preserve old GitHub deep links,
# but trimmed from the Composer dist archive (they only point at the focused guides).
/docs/orchestration-and-blueprints.md      export-ignore
/docs/pipelines-queues-and-memory.md       export-ignore
/docs/testing-with-fakes.md                export-ignore
/docs/provider-profile-presets.md          export-ignore
/docs/failure-normalization.md             export-ignore
/docs/github-ci-matrix.md                  export-ignore
/docs/laravel-ai-sdk-capability-matrix.md  export-ignore
/docs/release-verification.md              export-ignore
/docs/sdk-async-inventory.md               export-ignore
/docs/testing-strategy.md                  export-ignore
