includes:
    - phpstan-baseline.neon

parameters:
    paths:
        - src

    level: max

    excludePaths:
        analyseAndScan:
            - tests/**
            - vendor
            - stubs (?)
            - build (?)
            - .phpunit.cache (?)

    # No broad global ignores. If a false-positive is confirmed, add a narrowly scoped
    # ignore using `identifier` + `path`.
    ignoreErrors:
        -
            identifier: instanceof.alwaysTrue
            path: src/LaravelAiAgentKitServiceProvider.php
            message: '#^Instanceof between CreativeCrafts\\LaravelAiAgentKit\\Core\\Runtime\\SdkAiRuntime and CreativeCrafts\\LaravelAiAgentKit\\Contracts\\Core\\StreamingAiRuntime will always evaluate to true\.$#'

    bootstrapFiles:
        - vendor/autoload.php

    checkUninitializedProperties: true
    checkUnionTypes: true
    treatPhpDocTypesAsCertain: true
    inferPrivatePropertyTypeFromConstructor: true

    # Keep configuration hygiene: fail when ignore rules become stale.
    reportUnmatchedIgnoredErrors: true

    parallel:
        maximumNumberOfProcesses: 0
        minimumNumberOfJobsPerProcess: 1
        jobSize: 1
        processTimeout: 600.0