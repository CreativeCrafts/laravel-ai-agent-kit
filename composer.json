{
  "name": "creativecrafts/laravel-ai-agent-kit",
  "description": "Laravel AI Agent Kit is a Laravel package that delivers a structured agent-workflow toolkit on the official Laravel AI SDK: pipelines, queued jobs, multi-agent orchestration, safe tooling, resilience, and redacted domain events for operational visibility.",
  "keywords": [
    "CreativeCrafts",
    "laravel",
    "laravel-ai-agent-kit",
    "ai",
    "ai-agent"
  ],
  "homepage": "https://github.com/creativecrafts/laravel-ai-agent-kit",
  "license": "MIT",
  "authors": [
    {
      "name": "Godspower Oduose",
      "email": "creativecraftssolutions@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "laravel/ai": "^0.6",
    "spatie/laravel-package-tools": "^1.93"
  },
  "require-dev": {
    "laravel/pint": "^1.27",
    "nunomaduro/collision": "^8.9",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.11|11.1",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "rector/rector": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "CreativeCrafts\\LaravelAiAgentKit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CreativeCrafts\\LaravelAiAgentKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "analyse": "XDEBUG_MODE=off php vendor/bin/phpstan analyse --memory-limit=128G",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "pint": "vendor/bin/pint --parallel",
    "check-deps": "composer outdated --direct",
    "validate-composer": "composer validate --strict",
    "security-audit": "composer audit",
    "rector": "vendor/bin/rector --dry-run",
    "rector-fix": "vendor/bin/rector",
    "quality": [
      "@check-deps",
      "@validate-composer",
      "@security-audit",
      "@rector-fix",
      "@pint",
      "@analyse",
      "@test"
    ],
    "code-check": [
      "@pint",
      "@analyse",
      "@test"
    ],
    "ci": [
      "@validate-composer",
      "@security-audit",
      "@analyse",
      "@test-coverage"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CreativeCrafts\\LaravelAiAgentKit\\LaravelAiAgentKitServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
